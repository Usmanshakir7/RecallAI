# Works without credentials for demo and tests.
SAMPLE_MODE=true
SAMPLE_FALLBACK=true

# Meterless Nightshift local OpenAI-compatible runtime. Never commit real tokens.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_MODEL=meterless/auto
METERLESS_API_KEY=
# Alternatively, point to the runtime's proxy-token file.
METERLESS_TOKEN_FILE=
